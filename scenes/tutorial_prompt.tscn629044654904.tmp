[gd_scene format=3 uid="uid://cwcpf6w2puvbh"]

[sub_resource type="GDScript" id="GDScript_7hnv8"]
script/source = "extends CanvasLayer

@onready var container: MarginContainer = $MarginContainer
@onready var prompt_label: Label = $MarginContainer/PanelContainer/PromptLabel

enum Step { MOVE, INTERACT, COMPLETED }
var current_step: Step = Step.MOVE
var move_timer: float = 0.0

func _ready() -> void:
	prompt_label.text = \"Use [A] / [D] or [Left] / [Right] to Move\"
	container.modulate.a = 0.0
	# Fade in smoothly
	var tween = create_tween()
	tween.tween_property(container, \"modulate:a\", 1.0, 0.5)

func _process(delta: float) -> void:
	match current_step:
		Step.MOVE:
			var move_axis = Input.get_axis(\"ui_left\", \"ui_right\")
			if move_axis != 0.0:
				move_timer += delta
				if move_timer >= 1.2:
					_advance_to_interact()

		Step.INTERACT:
			if Input.is_action_just_pressed(\"ui_accept\"):
				_finish_tutorial()

func _advance_to_interact() -> void:
	current_step = Step.INTERACT
	prompt_label.text = \"Press [E] or [Space] to Interact\"

func _finish_tutorial() -> void:
	current_step = Step.COMPLETED
	var tween = create_tween()
	tween.tween_property(container, \"modulate:a\", 0.0, 0.4)
	await tween.finished
	queue_free()"

